{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://geospatial-data-analytics-plateform.onrender.com/:path*" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
