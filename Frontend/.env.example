# Optional public Mapbox token for satellite/street basemaps. Never put a secret token here.
VITE_MAPBOX_ACCESS_TOKEN=
# Without a token, the local coordinate workspace supports boundary viewing/drawing.

# Leave unset locally: Vite proxies /api to http://127.0.0.1:8000.
# On Vercel, set this to the deployed Render API URL, without a trailing slash.
# VITE_API_BASE_URL=https://darukaa-earth-api.onrender.com
