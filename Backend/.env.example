# Local PostgreSQL connection. Copy this file to .env and fill DB_PASSWORD.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=darukaa_earth
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Generate a random signing key; never commit the actual value.
# From Backend: .\venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30

# Comma-separated browser origins permitted to call the API.
# For production, use the exact Vercel deployment URL (for example,
# https://darukaa-earth.vercel.app). Do not include a trailing slash.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
